# ---------- Core VPN ----------
# NordVPN manual connections use the service credentials from Nord Account,
# not the account password or access token. TCP/443 is the reliable fallback
# when WireGuard/NordLynx is unavailable. Other providers may still use a
# supported manually issued WireGuard key.
VPN_SERVICE_PROVIDER=nordvpn
VPN_TYPE=openvpn
OPENVPN_USER=your_service_username_here
OPENVPN_PASSWORD=your_service_password_here
OPENVPN_PROTOCOL=tcp
WIREGUARD_PRIVATE_KEY=
DNS_UPSTREAM_RESOLVER_TYPE=doh

# Gluetun control server API key
GLUETUN_API_KEY=secret-key

# Public gateway authentication. Keep client keys independently revocable.
PINCHANA_API_KEYS={"bot":"replace-with-a-long-random-secret"}
# Clients allowed to request disposable Telegram media scopes and release them.
PINCHANA_TELEGRAM_CLIENTS=bot
# Named machine clients permitted to clear media cache; empty disables clearing.
PINCHANA_CACHE_ADMIN_CLIENTS=bot,telegram-bot

# Web authentication (direct Cloudflare Siteverify + signed sessions)
TURNSTILE_SECRET_KEY=replace-with-your-private-turnstile-secret
TURNSTILE_EXPECTED_HOSTNAME=pinchana.example.com
TURNSTILE_EXPECTED_ACTION=turnstile-spin-v1
TURNSTILE_SESSION_SECRET=replace-with-at-least-32-random-characters
TURNSTILE_SESSION_MAX_AGE=43200

# Mobile installation grants. The current distribution uses scoped,
# non-attested installation sessions when authentication is enabled. Public
# mobile scrape, media, and capability routes do not require a session.
MOBILE_AUTH_MODE=guest
MOBILE_AUTH_REQUIRED=false
MOBILE_SESSION_SECRET=replace-with-a-different-32-character-random-secret
MOBILE_ACCESS_TOKEN_MAX_AGE=900
MOBILE_REFRESH_TOKEN_MAX_AGE=2592000
MOBILE_CHALLENGE_TTL=120
MOBILE_CHALLENGE_RATE_WINDOW=600
MOBILE_CHALLENGE_RATE_LIMIT=10
# Enable only behind a trusted reverse proxy that overwrites these headers.
MOBILE_TRUST_PROXY_HEADERS=false
MOBILE_GUEST_SCOPES=mobile:scrape,mobile:media,mobile:capabilities
MOBILE_ATTESTATION_URL=
MOBILE_ATTESTATION_TOKEN=

# Production rolling images. Run scripts/update_rolling.py to pull the newest
# coherent release plus Gluetun and replace mutable discovery tags with digests.
GLUETUN_IMAGE=qmcgaw/gluetun:v3
SERVER_IMAGE=ghcr.io/pinchana/pinchana-api/server:stable

# Browser-encrypted private download service. Keep disabled until the DLP
# images, internal networks, capacity monitoring, and smoke test are ready.
DLP_ENABLED=false
DLP_GATEWAY_TOKEN=replace-with-a-long-random-service-secret
DLP_OWNER_SECRET=replace-with-a-different-owner-derivation-secret
DLP_REDIS_PASSWORD=replace-with-a-long-random-redis-secret
DLP_HOST_JOBS_DIR=/srv/pinchana-dlp/jobs
DLP_DOH_URL=https://cloudflare-dns.com/dns-query
# Production: add --dlp to update_rolling.py to include these in the same release.
DLP_WORKER_IMAGE=ghcr.io/pinchana/pinchana-api/dlp-worker:stable
DLP_API_IMAGE=ghcr.io/pinchana/pinchana-api/dlp-api:stable
DLP_ORCHESTRATOR_IMAGE=ghcr.io/pinchana/pinchana-api/dlp-orchestrator:stable
DLP_VPN_IMAGE=qmcgaw/gluetun:v3
DLP_WORKER_NETWORK=pinchana-dlp-worker
DLP_JOB_TTL_SECONDS=7200
DLP_KEY_TTL_SECONDS=300
DLP_MAX_ACTIVE_JOBS=3
DLP_RATE_LIMIT_PER_MINUTE=10
DLP_EXECUTION_TIMEOUT_SECONDS=2700
DLP_MAX_OUTPUT_BYTES=8589934592

# Project-issued certificate for this public API origin. The one-line JSON
# envelope is the simplest Docker Compose setup. A certificate file must be
# mounted into the server container and this path must be its container path.
# Never deploy the project signing key.
PINCHANA_INSTANCE_CERTIFICATE=
PINCHANA_INSTANCE_CERTIFICATE_FILE=

# Comma-separated list of preferred VPN server countries
SERVER_COUNTRIES=Netherlands,United States

# ---------- Compose Runtime ----------
# Container name used as shared network namespace parent
GLUETUN_CONTAINER_NAME=gluetun

# Optional custom container names (helpful when running multiple stacks)
SERVER_CONTAINER_NAME=pinchana-server

# Host ports (left side of docker port mappings)
API_HOST_PORT=8080
GLUETUN_CONTROL_HOST_PORT=8000
# Keep the privileged Gluetun control API local to the Docker host.
GLUETUN_CONTROL_BIND_ADDRESS=127.0.0.1

# Internal Gluetun control API port (container side)
GLUETUN_CONTROL_PORT=8000

# ---------- Module / Server behavior ----------
# Cache path used when running a service directly (Compose overrides this)
CACHE_PATH=./cache

# Shared media cache limit (GB)
CACHE_MAX_SIZE_GB=10.0
MEDIA_DOWNLOAD_CONCURRENCY=4
YTDLP_CONCURRENCY=1
# Use one canonical-page request for videos and first-Location short redirects
TIKTOK_DIRECT_WEB_PRIMARY=false
# Delay between independent TikTok jobs to reduce burst-rate throttling
TIKTOK_REQUEST_INTERVAL_SECONDS=2.0
# Optional delay between requests inside one job (normally unnecessary)
TIKTOK_INTERNAL_REQUEST_INTERVAL_SECONDS=0
# Delay before the one fresh-session retry on the current egress
TIKTOK_RETRY_DELAY_SECONDS=2.0
TIKTOK_FORMAT_ATTEMPTS=3
# Optional compatibility conversion for legacy clients without HEVC playback
TIKTOK_TRANSCODE_HEVC=false
TIKTOK_HEVC_TRANSCODE_TIMEOUT_SECONDS=180
# Minimum delay between TikTok-triggered Gluetun reconnects
TIKTOK_VPN_ROTATION_COOLDOWN_SECONDS=30
# Optional proxy for direct service deployments; development Compose does not
# set one and keeps VPN_ENABLED=false.
TIKTOK_PROXY_URL=

# Optional live TikTok test matrix against its standalone development app.
PINCHANA_TIKTOK_LIVE=0
TIKTOK_LIVE_BASE_URL=http://127.0.0.1:8081
TIKTOK_LIVE_VIDEO_URL=
TIKTOK_LIVE_PHOTO_URL=
TIKTOK_LIVE_SHORT_URL=
TIKTOK_LIVE_UNAVAILABLE_URL=
VPN_ENABLED=true

# Optional paid fallback for explicit Instagram post-level age gates only.
# Leave empty to preserve the normal restricted_media response without fallback.
# Shared by Instagram fallback and Apple Music track metadata lookups.
SOCIALCRAWL_API_KEY=
SOCIALCRAWL_TIMEOUT_SECONDS=20

# Direct-run Gluetun control endpoint
GLUETUN_CONTROL_URL=http://localhost:8000

# Maximum time for Coub video-loop muxing.
COUB_FFMPEG_TIMEOUT_SECONDS=300

# ---------- Shorts ----------
# Host directory containing YouTube cookies.txt files (mounted read-only into the gateway)
SHORTS_COOKIES_DIR=./secrets/yt-cookies

# Soft output size target for shorts (MB per minute). Set 0 to disable optimization
SHORTS_MAX_MB_PER_MINUTE=18.0

# Runtime cookie mount path inside the gateway
YTDLP_COOKIES_DIR=/run/pinchana-cookies

# Optional single cookie file used when no cookies directory is configured
YTDLP_COOKIE_FILE=

# ---------- Music Modules ----------
# Spotify API credentials (required for spotify module)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional operator Netscape YouTube cookies: youtube.txt in this directory.
# Read-only inside DLP API; user-supplied encrypted cookies take priority.
DLP_HOST_COOKIES_DIR=./secrets/dlp-cookies

# Raise quiet TikTok video audio toward -14 LUFS; video stream is copied.
TIKTOK_NORMALIZE_AUDIO=true
