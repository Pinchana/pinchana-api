REDIS_PASSWORD=replace-with-a-long-random-secret
DLP_GATEWAY_TOKEN=replace-with-a-different-long-random-secret
DLP_HOST_JOBS_DIR=/srv/pinchana-dlp/jobs
DLP_WORKER_IMAGE=pinchana-dlp-worker:latest
DLP_WORKER_NETWORK=pinchana-dlp-worker
DLP_JOB_TTL_SECONDS=7200
DLP_KEY_TTL_SECONDS=300
DLP_MAX_ACTIVE_JOBS=3
DLP_RATE_LIMIT_PER_MINUTE=10
DLP_EXECUTION_TIMEOUT_SECONDS=2700
DLP_MAX_OUTPUT_BYTES=8589934592
VPN_SERVICE_PROVIDER=nordvpn
# NordVPN no longer supports manual NordLynx setup. Prefer its manual OpenVPN
# service credentials and TCP/443; WireGuard remains available for providers
# that issue supported manual keys.
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
OPENVPN_PROTOCOL=tcp
WIREGUARD_PRIVATE_KEY=
SERVER_COUNTRIES=Netherlands
DNS_UPSTREAM_RESOLVER_TYPE=doh

# Optional operator YouTube Netscape cookies at <directory>/youtube.txt.
DLP_HOST_COOKIES_DIR=./secrets/dlp-cookies
